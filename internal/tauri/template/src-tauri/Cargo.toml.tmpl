# Generated by dboss build tauri; edits are overwritten on the next build.
[package]
name = "dboss-shell"
version = "0.1.0"
edition = "2021"

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{{- if .Crate}}
app_server = { package = {{printf "%q" .Crate}}, path = {{printf "%q" .CrateDir}}, optional = true }
{{- end}}

[features]
server = [{{if .Crate}}"dep:app_server"{{end}}]

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
strip = true
